{
  "name": "pinger",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --production --compile --minify ./src/index.ts --outfile pinger-bin",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --quiet",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
